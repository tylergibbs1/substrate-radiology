{
	auto_https off
}

:{$PORT:8080} {
	encode zstd gzip

	header {
		Origin-Agent-Cluster "?1"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; worker-src 'self' blob:; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'"
	}

	handle /healthz {
		respond "ok" 200
	}

	@dicomweb_read {
		path_regexp ^/dicom-web/(studies|series|instances)(/.*)?$
		method GET HEAD OPTIONS
	}
	handle @dicomweb_read {
		reverse_proxy http://{$ORTHANC_HOST}:8042 {
			header_up Authorization "Basic {$ORTHANC_READ_BASIC}"
			header_up Host {upstream_hostport}
			transport http {
				read_timeout 120s
			}
		}
	}

	handle /dicom-web/* {
		respond 405
	}

	handle {
		root * /srv
		header Cache-Control "no-cache"

		@assets path_regexp \.(js|css|wasm|woff2?|png|svg|ico)$
		header @assets Cache-Control "public, max-age=31536000, immutable"

		try_files {path} /index.html
		file_server
	}
}
